generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id       Int    @id @default(autoincrement())
  title    String
  capacity Int
}

model Instructor {
  id        Int    @id @default(autoincrement())
  name      String
  email     String @unique
  specialty String
}